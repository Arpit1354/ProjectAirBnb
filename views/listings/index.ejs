<% layout("/layouts/boilerplate") %>

<style>
  * { box-sizing: border-box; }

  /* ── HERO ── */
  .hero {
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    height: 460px;
    overflow: visible;
  }
  .hero-img-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .hero-img {
    width: 100%; height: 100%;
    object-fit: cover;
    animation: slow-zoom 12s ease-out forwards;
  }
  @keyframes slow-zoom { from { transform: scale(1.06); } to { transform: scale(1); } }

  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.6) 85%, rgba(0,0,0,0.72) 100%);
    pointer-events: none;
  }
  .hero-content {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center; padding: 0 24px 60px; gap: 14px;
  }
  .hero-badge {
    background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3);
    color: #fff; font-size: 12px; font-weight: 500;
    padding: 5px 14px; border-radius: 999px; letter-spacing: .04em;
  }
  .hero-title {
    font-size: clamp(26px, 4.5vw, 50px); font-weight: 800; color: #fff;
    line-height: 1.15; letter-spacing: -0.5px; max-width: 600px;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  .hero-title span { color: #ff8a8a; }
  .hero-sub {
    font-size: clamp(13px, 2vw, 15px);
    color: rgba(255,255,255,0.82); max-width: 400px; line-height: 1.6;
  }

  /* Hero search — hidden on desktop, shown on mobile */
  .hero-search {
    display: none;
    align-items: center; background: #fff;
    border-radius: 999px; padding: 6px 6px 6px 18px;
    width: 100%; max-width: 460px; margin-top: 4px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.2);
  }
  .hero-search input {
    flex: 1; border: none; outline: none; font-size: 14px;
    color: #111; background: transparent; min-width: 0;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  .hero-search input::placeholder { color: #aaa; }
  .hero-search-btn {
    background: #fe424d; border: none; border-radius: 999px;
    padding: 9px 18px; font-size: 13px; font-weight: 600;
    color: #fff; cursor: pointer; transition: background .15s;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
  .hero-search-btn:hover { background: #e03540; }

  .hero-stats { display: flex; gap: 28px; margin-top: 2px; }
  .hero-stat { text-align: center; }
  .hero-stat strong { display: block; font-size: 18px; font-weight: 700; color: #fff; }
  .hero-stat span { font-size: 11px; color: rgba(255,255,255,0.7); }

  /* ── RESPONSIVE HERO ── */
  @media (max-width: 768px) {
    .hero { height: 360px; }
    .hero-content { padding-bottom: 40px; }
    .hero-sub { display: none; }
    .hero-search { display: flex; }
    .hero-stats { gap: 16px; }
    .hero-stat strong { font-size: 15px; }
  }
  @media (max-width: 480px) {
    .hero { height: 300px; }
    .hero-badge { display: none; }
    .hero-stats { gap: 12px; }
    .hero-search-btn { padding: 8px 14px; font-size: 12px; }
  }

  /* ── FLOATING FILTER BAR ── */
  .filters-bar {
    position: relative;
    z-index: 10;
    margin: -32px auto 0;
    max-width: 920px;
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 8px 40px rgba(0,0,0,0.14);
    padding: 0 8px;
    display: flex;
    align-items: center;
  }
  .filters-scroll {
    display: flex; align-items: center;
    overflow-x: auto; scrollbar-width: none; flex: 1;
  }
  .filters-scroll::-webkit-scrollbar { display: none; }

  .filter-item {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    padding: 14px 20px; cursor: pointer;
    border-radius: 14px;
    transition: background .15s;
    white-space: nowrap; flex-shrink: 0; text-decoration: none;
  }
  .filter-item i { font-size: 19px; color: #555; transition: color .15s; }
  .filter-item span { font-size: 12px; color: #555; font-weight: 500; transition: color .15s; }
  .filter-item:hover { background: #f7f7f7; }
  .filter-item:hover i, .filter-item:hover span { color: #111; }
  .filter-item.active { background: #fff3f3; }
  .filter-item.active i { color: #fe424d; }
  .filter-item.active span { color: #fe424d; }

  .ft-divider { width: 1px; height: 32px; background: #f0f0f0; flex-shrink: 0; margin: 0 4px; }

  .tax-toggle {
    display: flex; align-items: center; gap: 8px;
    padding: 14px 16px; white-space: nowrap; flex-shrink: 0;
  }
  .tax-toggle span { font-size: 12.5px; color: #444; font-weight: 500; }
  .toggle-switch { position: relative; width: 40px; height: 22px; flex-shrink: 0; }
  .toggle-switch input { opacity: 0; width: 0; height: 0; }
  .toggle-track {
    position: absolute; inset: 0; background: #ddd;
    border-radius: 999px; cursor: pointer; transition: background .2s;
  }
  .toggle-track:before {
    content: ""; position: absolute; width: 16px; height: 16px;
    left: 3px; top: 3px; background: #fff; border-radius: 50%; transition: transform .2s;
  }
  .toggle-switch input:checked + .toggle-track { background: #fe424d; }
  .toggle-switch input:checked + .toggle-track:before { transform: translateX(18px); }

  /* on mobile — reset to normal bar */
  @media (max-width: 768px) {
    .filters-bar {
      margin: 16px 0 0;
      border-radius: 0;
      box-shadow: none;
      border-bottom: 1px solid #f0f0f0;
    }
    .filter-item { padding: 10px 16px; }
  }

  /* ── SECTION LABEL ── */
  .section-label {
    display: flex; align-items: center; justify-content: space-between;
    padding: 48px 0 16px;
  }
  .section-label h2 { font-size: 20px; font-weight: 700; color: #111; font-family: 'Plus Jakarta Sans', sans-serif; }
  .section-label a { font-size: 13.5px; color: #fe424d; text-decoration: none; font-weight: 500; }
  .section-label a:hover { text-decoration: underline; }

  /* ── LISTINGS GRID ── */
 /* ── LISTINGS GRID ── */
.listings-grid {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 20px; padding: 24px 0 56px;
}
@media (max-width: 1100px) { .listings-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 760px)  { .listings-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; } }
@media (max-width: 480px)  { .listings-grid { grid-template-columns: 1fr; } }

.listing-card {
  text-decoration: none; color: inherit; display: block;
  transition: transform .2s;
}
.listing-card:hover { transform: translateY(-4px); }

.card-img-wrap {
  position: relative; width: 100%; padding-top: 68%;
  overflow: hidden; border-radius: 16px;
}
.card-img-wrap img {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; transition: transform .4s ease;
}
.listing-card:hover .card-img-wrap img { transform: scale(1.06); }

/* gradient overlay on image bottom */
.card-img-gradient {
  position: absolute; bottom: 0; left: 0; right: 0; height: 50%;
  background: linear-gradient(to top, rgba(0,0,0,0.42) 0%, transparent 100%);
  border-radius: 0 0 16px 16px; pointer-events: none;
}

/* price badge on image */
.card-price-badge {
  position: absolute; bottom: 12px; left: 12px;
  background: rgba(255,255,255,0.95);
  border-radius: 999px; padding: 4px 10px;
  font-size: 13px; font-weight: 600; color: #111;
}

/* guest favourite badge */
.guest-badge {
  position: absolute; top: 12px; left: 12px;
  background: rgba(255,255,255,0.95);
  border-radius: 999px; padding: 4px 10px;
  font-size: 11px; font-weight: 600; color: #111;
}

.wishlist-btn {
  position: absolute; top: 12px; right: 12px;
  background: rgba(255,255,255,0.88); border: none; border-radius: 50%;
  width: 34px; height: 34px; display: flex; align-items: center;
  justify-content: center; cursor: pointer;
  transition: background .15s, transform .1s;
}
.wishlist-btn:hover { background: #fff; transform: scale(1.1); }
.wishlist-btn svg {
  width: 16px; height: 16px; fill: none; stroke: #333; stroke-width: 2;
  transition: fill .2s, stroke .2s, transform .25s cubic-bezier(.36,.07,.19,.97);
}
.wishlist-btn.liked svg { fill: #fe424d; stroke: #fe424d; }
.wishlist-btn.pop svg { transform: scale(1.45); }

.card-info { padding: 12px 2px 0; display: flex; flex-direction: column; gap: 3px; }
.card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
.card-title { font-size: 14px; font-weight: 600; color: #111; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; }
.card-rating { display: flex; align-items: center; gap: 3px; flex-shrink: 0; font-size: 13px; font-weight: 500; color: #111; }
.card-rating svg { width: 12px; height: 12px; fill: #111; }
.card-location { font-size: 12.5px; color: #888; }
.card-nights { font-size: 12.5px; color: #bbb; }
</style>

<!-- HERO -->
<div class="hero">
  <div class="hero-img-wrap">
    <img class="hero-img"
      src="https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?w=1400&q=85"
      alt="Wanderlust hero" />
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <div class="hero-badge">✦ Over 1,000 unique stays across India</div>
    <h1 class="hero-title">Find your next <span>perfect escape</span></h1>
    <p class="hero-sub">Handpicked homes, cabins, villas and more — for every kind of traveller.</p>
    <div class="hero-search">
      <input type="search" placeholder="Where do you want to go?" />
      <button class="hero-search-btn" type="button">Search</button>
    </div>
    <div class="hero-stats">
      <div class="hero-stat"><strong>1,200+</strong><span>Listings</span></div>
      <div class="hero-stat"><strong>4.9 ★</strong><span>Avg rating</span></div>
      <div class="hero-stat"><strong>50+</strong><span>Destinations</span></div>
    </div>
  </div>
</div>

<!-- FLOATING FILTERS -->
<div class="filters-bar">
  <div class="filters-scroll">
    <div class="filter-item active"><i class="fa-solid fa-fire"></i><span>Trending</span></div>
    <div class="filter-item"><i class="fa-solid fa-bed"></i><span>Rooms</span></div>
    <div class="filter-item"><i class="fa-solid fa-mountain-city"></i><span>Iconic cities</span></div>
    <div class="filter-item"><i class="fa-solid fa-mountain"></i><span>Mountains</span></div>
    <div class="filter-item"><i class="fa-brands fa-fort-awesome"></i><span>Castles</span></div>
    <div class="filter-item"><i class="fa-solid fa-person-swimming"></i><span>Arctic pools</span></div>
    <div class="filter-item"><i class="fa-solid fa-campground"></i><span>Camping</span></div>
    <div class="filter-item"><i class="fa-solid fa-cow"></i><span>Farms</span></div>
  </div>
  <div class="ft-divider"></div>
  <div class="tax-toggle">
    <span>Total after taxes</span>
    <label class="toggle-switch">
      <input type="checkbox" id="taxToggle" />
      <div class="toggle-track"></div>
    </label>
  </div>
</div>

<!-- LISTINGS -->
<div class="listings-grid">
  <% for(let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-card">
      <div class="card-img-wrap">
        <img src="<%= listing.image.url %>" alt="<%= listing.title %>" loading="lazy" />
        <div class="card-img-gradient"></div>
        <div class="guest-badge">Guest favourite</div>
        <button class="wishlist-btn">
          <svg viewBox="0 0 24 24">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </button>
        <div class="card-price-badge">₹<%= listing.price.toLocaleString("en-IN") %> / night</div>
      </div>
      <div class="card-info">
        <div class="card-top">
          <span class="card-title"><%= listing.title %></span>
          <span class="card-rating">
            <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            4.9
          </span>
        </div>
        <span class="card-location"><%= listing.location %></span>
      </div>
    </a>
  <% } %>
</div>

<div class="listings-grid">
  <% for(let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-card">
      <div class="card-img-wrap">
        <img src="<%= listing.image.url %>" alt="<%= listing.title %>" loading="lazy" />
        <button class="wishlist-btn">
          <svg viewBox="0 0 24 24">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </button>
      </div>
      <div class="card-info">
        <div class="card-title"><%= listing.title %></div>
        <div class="card-location"><%= listing.location %></div>
        <div class="card-price">
          <strong>₹<%= listing.price.toLocaleString("en-IN") %></strong> / night
          <span class="gst-info">+18% GST</span>
        </div>
      </div>
    </a>
  <% } %>
</div>

<script>
  document.querySelectorAll('.filter-item').forEach(function(el) {
    el.addEventListener('click', function() {
      document.querySelectorAll('.filter-item').forEach(function(f) { f.classList.remove('active'); });
      el.classList.add('active');
    });
  });

  document.getElementById('taxToggle').addEventListener('change', function() {
    document.querySelectorAll('.gst-info').forEach(function(g) {
      g.classList.toggle('show', this.checked);
    }, this);
  });

  document.querySelectorAll('.wishlist-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      this.classList.toggle('liked');
      this.classList.add('pop');
      setTimeout(() => this.classList.remove('pop'), 200);
    });
  });
  // ── Mobile hero search ──
(function () {
  const input = document.querySelector('.hero-search input');
  const btn = document.querySelector('.hero-search-btn');
  if (!input) return;

  const params = new URLSearchParams(window.location.search);
  const s = params.get('search');
  if (s) input.value = s;

  function doSearch(val) {
    const q = val.trim();
    window.location.href = q
      ? '/listings?search=' + encodeURIComponent(q)
      : '/listings';
  }

  input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') { e.preventDefault(); doSearch(this.value); }
  });

  if (btn) btn.addEventListener('click', function() {
    doSearch(input.value);
  });

  input.addEventListener('search', function() {
    if (this.value === '') window.location.href = '/listings';
  });
})();
</script>