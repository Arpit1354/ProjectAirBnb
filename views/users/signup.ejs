<% layout("/layouts/boilerplate") %>

<style>
  * { box-sizing: border-box; }

  .auth-page {
    min-height: calc(100vh - 64px);
    display: flex; align-items: center; justify-content: center;
    padding: 40px 16px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: #f7f7f7;
  }

  .auth-card {
    background: #fff; border-radius: 20px;
    border: 1px solid #ebebeb;
    width: 100%; max-width: 420px;
    overflow: hidden;
  }

  .auth-header {
    padding: 32px 32px 24px;
    border-bottom: 1px solid #f0f0f0;
    text-align: center;
  }
  .auth-logo {
    width: 44px; height: 44px; background: #fe424d;
    border-radius: 12px; display: flex; align-items: center;
    justify-content: center; margin: 0 auto 14px;
  }
  .auth-logo i { color: #fff; font-size: 20px; }
  .auth-title { font-size: 22px; font-weight: 800; color: #111; letter-spacing: -0.3px; margin-bottom: 4px; }
  .auth-sub { font-size: 14px; color: #888; }

  .auth-body { padding: 28px 32px; }

  .af-field { margin-bottom: 18px; }
  .af-field label {
    display: block; font-size: 13px; font-weight: 500;
    color: #444; margin-bottom: 6px;
  }
  .af-field input {
    width: 100%; padding: 11px 14px;
    border: 1.5px solid #e8e8e8; border-radius: 10px;
    font-size: 14px; color: #111; background: #fafafa;
    font-family: 'Plus Jakarta Sans', sans-serif;
    transition: border-color .15s, box-shadow .15s; outline: none;
  }
  .af-field input:focus {
    border-color: #fe424d; background: #fff;
    box-shadow: 0 0 0 3px rgba(254,66,77,.08);
  }
  .af-field input::placeholder { color: #bbb; }

  /* Password toggle */
  .pw-wrap { position: relative; }
  .pw-toggle {
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    background: none; border: none; cursor: pointer;
    color: #aaa; font-size: 14px; padding: 0;
    transition: color .15s;
  }
  .pw-toggle:hover { color: #555; }

  .af-field .valid-feedback {
    font-size: 12px; color: #16a34a; margin-top: 5px; display: none;
  }
  .af-field input.is-valid ~ .valid-feedback { display: block; }
  .af-field .invalid-msg {
    font-size: 12px; color: #fe424d; margin-top: 5px; display: none;
  }
  .af-field input.is-invalid ~ .invalid-msg { display: block; }

  .btn-signup {
    width: 100%; padding: 13px; background: #fe424d; color: #fff;
    border: none; border-radius: 10px; font-size: 15px; font-weight: 700;
    cursor: pointer; font-family: 'Plus Jakarta Sans', sans-serif;
    transition: background .15s, transform .1s; margin-top: 4px;
  }
  .btn-signup:hover { background: #e03540; }
  .btn-signup:active { transform: scale(.98); }

  .auth-divider {
    display: flex; align-items: center; gap: 12px;
    margin: 20px 0; color: #ccc; font-size: 13px;
  }
  .auth-divider::before,
  .auth-divider::after {
    content: ''; flex: 1; height: 1px; background: #f0f0f0;
  }

  .auth-footer {
    padding: 20px 32px 28px; text-align: center;
    border-top: 1px solid #f5f5f5;
  }
  .auth-footer p { font-size: 13.5px; color: #888; }
  .auth-footer a { color: #fe424d; text-decoration: none; font-weight: 600; }
  .auth-footer a:hover { text-decoration: underline; }

  .terms-note {
    font-size: 12px; color: #bbb; text-align: center;
    margin-top: 14px; line-height: 1.6;
  }
  .terms-note a { color: #aaa; text-decoration: underline; }

  @media (max-width: 480px) {
    .auth-header { padding: 24px 20px 20px; }
    .auth-body { padding: 20px; }
    .auth-footer { padding: 16px 20px 24px; }
  }
</style>

<div class="auth-page">
  <div class="auth-card">

    <div class="auth-header">
      <div class="auth-logo"><i class="fa-regular fa-compass"></i></div>
      <h1 class="auth-title">Join Wanderlust</h1>
      <p class="auth-sub">Create your account and start exploring</p>
    </div>

    <div class="auth-body">
      <form action="/user/signup" method="POST" class="needs-validation" novalidate id="signupForm">

        <div class="af-field">
          <label for="username">Username</label>
          <input
            name="username" id="username"
            type="text" placeholder="e.g. arpit1354"
            autocomplete="username" required
          />
          <div class="valid-feedback">Looks good!</div>
          <div class="invalid-msg">Please choose a username</div>
        </div>

        <div class="af-field">
          <label for="email">Email address</label>
          <input
            name="email" id="email"
            type="email" placeholder="you@example.com"
            autocomplete="email" required
          />
          <div class="invalid-msg">Please enter a valid email</div>
        </div>

        <div class="af-field">
          <label for="password">Password</label>
          <div class="pw-wrap">
            <input
              name="password" id="password"
              type="password" placeholder="Min. 6 characters"
              autocomplete="new-password" required
            />
            <button type="button" class="pw-toggle" id="pwToggle">
              <i class="fa-regular fa-eye" id="pwIcon"></i>
            </button>
          </div>
          <div class="invalid-msg">Please enter a password</div>
        </div>

        <button class="btn-signup" type="submit">Create account</button>

        <p class="terms-note">
          By signing up you agree to our
          <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>
        </p>
      </form>
    </div>

    <div class="auth-footer">
      <p>Already have an account? <a href="/user/login">Log in</a></p>
    </div>

  </div>
</div>

<script>
  // Password show/hide toggle
  var pwInput = document.getElementById('password');
  var pwIcon = document.getElementById('pwIcon');
  document.getElementById('pwToggle').addEventListener('click', function() {
    var isText = pwInput.type === 'text';
    pwInput.type = isText ? 'password' : 'text';
    pwIcon.className = isText ? 'fa-regular fa-eye' : 'fa-regular fa-eye-slash';
  });

  // Live validation
  document.getElementById('signupForm').addEventListener('submit', function(e) {
    var valid = true;
    this.querySelectorAll('[required]').forEach(function(input) {
      if (!input.value.trim()) {
        input.classList.add('is-invalid');
        input.classList.remove('is-valid');
        valid = false;
      } else {
        input.classList.remove('is-invalid');
        input.classList.add('is-valid');
      }
    });
    if (!valid) e.preventDefault();
  });

  document.querySelectorAll('.af-field input').forEach(function(input) {
    input.addEventListener('input', function() {
      if (this.value.trim()) {
        this.classList.remove('is-invalid');
        this.classList.add('is-valid');
      } else {
        this.classList.remove('is-valid');
      }
    });
  });
</script>